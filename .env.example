# ==============================================================================
# PaySight Environment Configuration
# ==============================================================================
# ZERO-CONFIGURATION DEMO MODE:
# Leave API keys empty to run PaySight in Demo Mode using local persistence
# (.data/paysight-db.json) with deterministic merchant sample records.
# ==============================================================================

# ─── PayPal Sandbox Credentials (Required for PayPal Sandbox Mode) ────────────
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
# Enable "Transaction Search", "Invoicing", and "Customer Disputes" in App settings.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Browser-exposed client ID for PayPal Checkout JS SDK Buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Required for fail-closed PayPal webhook signature verification (/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=

# ─── AI Copilot Configuration (Optional — falls back to deterministic local tools) ─
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Market Intelligence (Channel3, Optional — falls back to demo sample catalog) ─
# Obtain from: https://trychannel3.com/
CHANNEL3_API_KEY=

# ─── Persistence Path Override (Optional — defaults to .data/paysight-db.json) ─
# PAYSIGHT_DB_PATH=.data/paysight-db.json
