# ==============================================================================
# PaySight Environment Configuration (Live Credentials Required — No Mocks)
# ==============================================================================
# PaySight operates strictly with live APIs and fails closed (HTTP 503) when
# required credentials are absent.
# ==============================================================================

# ─── Supabase Authentication (Required for login/signup/session management) ───
# Obtain from: https://supabase.com/dashboard → Project → Settings → API
# Use the "Project URL" for SUPABASE_URL.
# Use the "anon public" key for SUPABASE_PUBLISHABLE_KEY (safe for browsers).
# NEVER use the service_role key on the client side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── PayPal Sandbox Credentials (Required for PayPal Sandbox Mode) ────────────
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
# Enable "Transaction Search", "Invoicing", and "Customer Disputes" in App settings.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Browser-exposed client ID for PayPal Checkout JS SDK Buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Required for fail-closed PayPal webhook signature verification (/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=

# ─── AI Copilot Configuration (Required for /api/chat — fails closed 503 if unset) ─
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── Market Intelligence (Channel3 — fails closed 503 if unset) ─────────────────
# Obtain from: https://trychannel3.com/
CHANNEL3_API_KEY=

# ─── Persistence Path Override (Optional — defaults to .data/paysight-db.json) ─
# PAYSIGHT_DB_PATH=.data/paysight-db.json

# ─── PostgreSQL / Neon (Deferred — see db/migrations/001_init.sql) ───────────
# Optional for future multi-instance SQL persistence; not required for local Sandbox operation.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
